      },
      "maquilaIncluyeEmpaque": {
        "description": "Solo aplica si esMaquila es true: si la tarifa del maquilador ya incluye empacar y etiquetar el producto terminado (entrega llave en mano)",
        "example": false,
        "type": "boolean",
      },
      "margenPorcentaje": {
        "description": "Margen usado para esta orden (si no se envia, se usa el de la formulacion)",
        "type": "number",
      },
      "notasCalidad": {
        "description": "Notas de control de calidad (ej. motivo de un rechazo)",
        "type": "string",
      },
      "numeroLote": {
        "description": "Numero de lote para trazabilidad. Si no se envia, se genera automaticamente.",
        "type": "string",
      },
      "precioVentaReal": {
        "description": "Precio de venta real cobrado (si se conoce); si no se envia, se usa el sugerido como estimado",
