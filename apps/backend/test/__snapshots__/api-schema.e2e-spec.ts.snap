        "type": "number",
      },
      "tiempoProduccionHoras": {
        "description": "Horas estimadas de produccion de este lote (snapshot de tiempoProduccionHoras de la formulacion, escalado a la cantidad)",
        "example": 2,
        "type": "number",
      },
      "unidadPresentacion": {
        "description": "Unidad del tamano de presentacion",
        "enum": [
          "ml",
          "L",
          "g",
          "kg",
        ],
        "type": "string",
      },
    },
    "type": "object",
  },
  "UpdateProfileDto": {
